choice
	prompt "ArtInChip Panel Drivers"

config AIC_PANEL_RGB_GENERAL
	bool "ArtInChip general RGB panel"
	depends on BACKLIGHT_CLASS_DEVICE && AIC_DISP_RGB
	help
	  ArtInChip general RGB panel
	  A generic driver for RGB panels configured through device tree
	  timings. Use it for panels without a dedicated driver, such as
	  generic 800x480 RGB screens. If unsure, say N.

config AIC_PANEL_LVDS_GENERAL
	bool "ArtInChip general LVDS panel"
	depends on BACKLIGHT_CLASS_DEVICE && AIC_DISP_LVDS
	help
	  ArtInChip general LVDS panel
	  A generic driver for LVDS panels configured through device tree
	  timings. Use it for panels without a dedicated driver.
	  If unsure, say N.

config AIC_PANEL_DSI_SIMPLE
	bool "ArtInChip dsi simale panel driver"
	depends on BACKLIGHT_CLASS_DEVICE && AIC_DISP_MIPI_DSI
	help
	  ArtInChip MIPI DSI simple panel
	  A minimal driver for DSI panels driven purely by device tree
	  sequences. Prefer a dedicated panel driver when one exists.
	  If unsure, say N.

config AIC_PANEL_DSI_NV3051
	bool "ArtInChip dsi panel driver for NV3051"
	depends on BACKLIGHT_CLASS_DEVICE && AIC_DISP_MIPI_DSI
	help
	  Say Y here if you want to enable support for the NV3051 MIPI DSI panel.
	  The driver covers init sequence and backlight handling for this
	  panel. Enable it only on boards wired to an NV3051 screen.

