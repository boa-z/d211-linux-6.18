config ARTINCHIP_GE
	tristate "ArtInChip 2D Graphics Engine"
	default n
	help
	  This is a 2D Graphics Engine driver
	  It accelerates fill, blit, rotate and scaler operations for the
	  display stack through the GE hardware block. Enable it on boards
	  that use the ArtInChip framebuffer.
choice
	prompt "select 2D Graphics Engine Mode"
	default ARTINCHIP_GE_NORMAL
	depends on ARTINCHIP_GE

config ARTINCHIP_GE_CMDQ
	bool "CMD queue mode"
	help
	  Enable CMD Queue
	  Command queue mode batches GE jobs for lower CPU overhead.
	  It needs firmware support in the GE block; keep normal mode
	  unless the board validates queue mode.

config ARTINCHIP_GE_NORMAL
	bool "normal mode"
	help
	  Disable CMD Queue
	  Normal mode submits GE jobs one by one from the driver.
	  This is the validated default; use it unless CMD queue mode
	  is explicitly required.

endchoice

if ARTINCHIP_GE
config CTRL_GE_CLK_IN_FRAME
	bool "ArtInChip GE Clock Ctrl In Frames"
	default n
	help
	  This is a GE Clock Ctrl in frames
	  It gates the GE clock between frames to save power.
	  Enable it on battery powered designs; leave it off when
	  validating GE throughput.
endif
