config CLK_ARTINCHIP
	bool "Clock driver for Artinchip SoC"
	depends on ARCH_ARTINCHIP
	default y
	help
	  Clock driver for Artinchip SoC.
	  It registers the CMU PLLs, fixed factors and peripheral gates,
	  and is required by every other ArtInChip peripheral driver.
	  If unsure, say Y when building for ArtInChip SoCs.

if CLK_ARTINCHIP
choice
	prompt "Artinchip CMU Drivers"

config CLK_ARTINCHIP_V10
	bool "CMU V1.0 driver"
	depends on MACH_D211
	help
	  For CMU V1.0 of Artinchip SoC.
	  This covers the clock controller found on the D211 series,
	  including the fractional PLL and the display SPI modules.
	  Select it for D211 based boards.
endchoice
endif
