if ARCH_ARTINCHIP

config PINCTRL_ARTINCHIP
	bool
	select PINMUX
	select GENERIC_PINCONF
	select GPIOLIB
	select GENERIC_IRQ_CHIP

config PINCTRL_ARTINCHIP_V0_1
	bool "Artinchip pin controller version0.1 device driver"
	depends on OF && ARCH_ARTINCHIP && ARM
	select PINCTRL_ARTINCHIP
	help
	  Enable pinctrl version1 driver for Artinchip SoC.
	  This covers the V0.1 pin controller on ARM based ArtInChip
	  parts. It is unused on RISC-V D211, where V1 applies instead.
	  If unsure, say N.

config PINCTRL_ARTINCHIP_V1
	bool "Artinchip pin controller version1 device driver"
	depends on OF && ARCH_ARTINCHIP && RISCV
	select PINCTRL_ARTINCHIP
	help
	  Enable pinctrl version1 driver for Artinchip SoC.
	  This covers the pin controller on the RISC-V D211 series,
	  including pinmux, pull, drive-strength and GPIO ranges.
	  Required on D211, keep it enabled.

endif
